# Copia este archivo como .env.local y ajusta los valores (.env.local no se sube a git).

# URL base del API que usa el navegador.
# En desarrollo déjala comentada: el frontend usa /api/v1 y Vite lo reenvía al backend.
# En producción, si el backend está en otro dominio: VITE_API_URL=https://api.edutrace.ejemplo/api/v1
# VITE_API_URL=

# A dónde reenvía Vite las peticiones /api en desarrollo (solo lo usa `npm run dev`).
# VITE_BACKEND_URL=http://localhost:8000
